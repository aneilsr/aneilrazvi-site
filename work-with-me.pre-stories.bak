<style>
  .wm-hero{padding:9rem 6% 2rem;max-width:1140px;margin:0 auto}
  .wm-hero .eyebrow{color:var(--teal);font-size:.78rem;font-weight:700;letter-spacing:.15em;text-transform:uppercase}
  .wm-hero h1{font-family:'DM Serif Display',serif;font-size:clamp(2.6rem,6vw,4.2rem);color:#fff;font-weight:400;margin:.4rem 0 1.2rem;line-height:1.08}
  .wm-hero h1 em{font-style:italic;color:var(--teal)}
  .wm-hero p{max-width:720px;color:rgba(255,255,255,.72);font-size:1.14rem;line-height:1.75;font-weight:300}
  .wm-heroimg{width:100%;margin:2.6rem 0 0;padding:0;position:relative}
  .wm-heroimg::after{content:"";position:absolute;inset:0;pointer-events:none;
    background:linear-gradient(to bottom,rgba(15,25,35,.35) 0%,transparent 22%,transparent 78%,rgba(15,25,35,.55) 100%)}
  .wm-heroimg img{width:100%;display:block;aspect-ratio:2000/1250;max-height:64vh;object-fit:cover;
    object-position:center 38%;border-radius:0;border:0;border-top:1px solid rgba(0,188,212,.18);
    border-bottom:1px solid rgba(0,188,212,.18)}
  .wm-sec{max-width:1040px;margin:0 auto;padding:4rem 6%}
  .wm-sec h2{font-family:'DM Serif Display',serif;font-size:clamp(1.8rem,3.2vw,2.5rem);color:#fff;font-weight:400;margin:0 0 2rem}
  .wm-services{display:grid;grid-template-columns:repeat(3,1fr);gap:1.6rem}
  .wm-card{border-top:2px solid var(--teal);padding-top:1.1rem}
  .wm-card h3{font-family:'DM Serif Display',serif;font-size:1.18rem;color:#fff;font-weight:400;margin:0 0 .5rem}
  .wm-card p{color:rgba(255,255,255,.66);font-size:.94rem;line-height:1.6;font-weight:300;margin:0}
  /* design maturity ladder */
  .wm-maturity{background:#0c1620;border-top:1px solid rgba(255,255,255,.08);border-bottom:1px solid rgba(255,255,255,.08)}
  .wm-maturity-in{max-width:1140px;margin:0 auto;padding:4rem 6%}
  .wm-maturity .eyebrow{color:var(--teal);font-size:.72rem;font-weight:700;letter-spacing:.15em;text-transform:uppercase}
  .wm-maturity h2{font-family:'DM Serif Display',serif;font-size:clamp(1.7rem,3vw,2.3rem);color:#fff;font-weight:400;margin:.5rem 0 .7rem}
  .wm-maturity .sub{color:rgba(255,255,255,.68);font-size:1.02rem;line-height:1.7;font-weight:300;max-width:660px;margin:0 0 2.2rem}
  .wm-ladder{display:grid;grid-template-columns:repeat(5,1fr);gap:1.1rem}
  .rung{border-top:2px solid rgba(0,188,212,.35);padding-top:.95rem}
  .rung .lvl{font-size:.68rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--teal);margin-bottom:.45rem}
  .rung h4{font-family:'DM Serif Display',serif;color:#fff;font-size:1.05rem;font-weight:400;margin:0 0 .4rem;line-height:1.2}
  .rung p{color:rgba(255,255,255,.6);font-size:.82rem;line-height:1.5;font-weight:300;margin:0}
  .wm-maturity .closer{color:rgba(255,255,255,.82);font-size:1rem;line-height:1.65;font-weight:300;margin:2rem 0 0;border-left:2px solid var(--teal);padding-left:1rem}
  @media(max-width:820px){.wm-ladder{grid-template-columns:1fr 1fr}}
  @media(max-width:520px){.wm-ladder{grid-template-columns:1fr}}
  .wm-steps{display:grid;grid-template-columns:repeat(3,1fr);gap:2rem}
  .wm-step .n{font-family:'DM Serif Display',serif;font-size:2.4rem;color:var(--teal);line-height:1;display:block;margin-bottom:.5rem}
  .wm-step h3{font-family:'DM Serif Display',serif;font-size:1.2rem;color:#fff;font-weight:400;margin:0 0 .5rem}
  .wm-step p{color:rgba(255,255,255,.66);font-size:.94rem;line-height:1.6;font-weight:300;margin:0}
  .wm-recs{display:grid;grid-template-columns:1fr 1fr;gap:1.4rem}
  .rec{background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.09);border-radius:14px;padding:1.6rem 1.7rem}
  .rec p.q{color:rgba(255,255,255,.82);font-size:.98rem;line-height:1.65;font-weight:300;margin:0 0 1.1rem}
  .rec .who{display:flex;align-items:center;gap:.8rem}
  .rec .av{width:44px;height:44px;border-radius:50%;border:1px solid rgba(0,188,212,.35);object-fit:cover;flex-shrink:0;display:block}
  .rec .nm{color:#fff;font-size:.92rem;font-weight:600}
  .rec .nm a{color:#fff;text-decoration:none;border-bottom:1px solid rgba(0,188,212,.4)}
  .rec .rl{color:rgba(255,255,255,.55);font-size:.8rem}
  .wm-cta{background:linear-gradient(135deg,#0d1b2a,#0a2530);text-align:center;padding:5rem 6%}
  .wm-cta h2{font-family:'DM Serif Display',serif;font-size:2.2rem;color:#fff;font-weight:400;margin:0 0 1.5rem}
  .wm-cta a{background:var(--teal);color:#062028;padding:14px 30px;border-radius:8px;font-weight:700;text-decoration:none;display:inline-block}
  @media(max-width:820px){.wm-services{grid-template-columns:1fr 1fr}.wm-steps{grid-template-columns:1fr}}
  @media(max-width:600px){.wm-services{grid-template-columns:1fr}.wm-recs{grid-template-columns:1fr}}

  /* tabs: two ways to buy the same person */
  .wm-tabs{max-width:1040px;margin:2.6rem auto 0;padding:0 6%}
  .wm-tablist{display:flex;gap:2rem;border-bottom:1px solid rgba(255,255,255,.12)}
  .wm-tab{appearance:none;background:none;border:0;padding:0 0 .9rem;cursor:pointer;
    font-family:'DM Serif Display',serif;font-size:clamp(1.1rem,2.2vw,1.35rem);
    color:rgba(255,255,255,.5);border-bottom:2px solid transparent;margin-bottom:-1px;
    transition:color .2s ease,border-color .2s ease}
  .wm-tab:hover{color:rgba(255,255,255,.8)}
  .wm-tab[aria-selected="true"]{color:#fff;border-bottom-color:var(--teal)}
  .wm-tab:focus-visible{outline:2px solid var(--teal);outline-offset:4px;border-radius:3px}
  .wm-tabnote{color:rgba(255,255,255,.5);font-size:.86rem;font-weight:300;margin:.9rem 0 0;max-width:640px}
  [hidden]{display:none!important}

  /* workshop panel */
  .ws-lead{max-width:1040px;margin:0 auto;padding:3.4rem 6% 0}
  .ws-lead .kicker{color:var(--teal);font-size:.72rem;font-weight:700;letter-spacing:.15em;text-transform:uppercase}
  .ws-lead h2{font-family:'DM Serif Display',serif;font-size:clamp(1.8rem,3.2vw,2.5rem);color:#fff;font-weight:400;margin:.55rem 0 1.1rem;line-height:1.2}
  .ws-lead p{color:rgba(255,255,255,.72);font-size:1.06rem;line-height:1.75;font-weight:300;max-width:720px;margin:0}
  .ws-lead p+p{margin-top:1.05rem}
  .ws-lead p b{color:#fff;font-weight:600}

  .ws-band{margin:3rem 0 0}
  .ws-band img{width:100%;display:block;aspect-ratio:2000/860;height:auto;max-height:48vh;object-fit:cover;object-position:center 45%;
    border-top:1px solid rgba(0,188,212,.18);border-bottom:1px solid rgba(0,188,212,.18);background:#0a1620}
  .ws-band figcaption{max-width:1040px;margin:.85rem auto 0;padding:0 6%;color:rgba(255,255,255,.4);font-size:.8rem;font-weight:300}

  .ws-list{max-width:1040px;margin:3rem auto 0;padding:0 6%;display:grid;gap:.8rem}
  .wsx{background:rgba(255,255,255,.035);border:1px solid rgba(255,255,255,.09);border-radius:14px;transition:border-color .2s ease,background .2s ease}
  .wsx:hover{border-color:rgba(255,255,255,.16)}
  .wsx[open]{background:rgba(255,255,255,.055);border-color:rgba(0,188,212,.3)}
  .wsx>summary{list-style:none;cursor:pointer;padding:1.3rem 1.5rem;display:grid;grid-template-columns:1fr auto;gap:1rem;align-items:start}
  .wsx>summary::-webkit-details-marker{display:none}
  .wsx>summary:focus-visible{outline:2px solid var(--teal);outline-offset:3px;border-radius:13px}
  .wsx h3{font-family:'DM Serif Display',serif;color:#fff;font-size:1.16rem;font-weight:400;margin:0;line-height:1.3}
  .wsx h3 .num{color:var(--teal);font-size:.94rem;margin-right:.5rem}
  .wsx .tag{color:rgba(255,255,255,.63);font-size:.93rem;font-weight:300;line-height:1.6;margin:.4rem 0 0;max-width:640px}
  .wsx .chev{color:rgba(255,255,255,.4);font-size:.8rem;line-height:1;margin-top:.45rem;transition:transform .2s ease,color .2s ease}
  .wsx[open] .chev{transform:rotate(180deg);color:var(--teal)}
  .wsx .meta{display:flex;gap:.45rem;flex-wrap:wrap;margin-top:.85rem}
  .wsx .pill{font-size:.71rem;letter-spacing:.04em;color:var(--teal);border:1px solid rgba(0,188,212,.35);border-radius:999px;padding:3px 9px;white-space:nowrap}
  .wsx .pill.plain{color:rgba(255,255,255,.5);border-color:rgba(255,255,255,.15)}
  .wsx .body{padding:0 1.5rem 1.55rem}
  .wsx .now{color:rgba(255,255,255,.8);font-size:.94rem;line-height:1.7;font-weight:300;
    border-left:2px solid var(--teal);padding:.1rem 0 .1rem 1rem;margin:.2rem 0 1.15rem;max-width:660px}
  .wsx .now b{color:var(--teal);font-weight:600}
  .wsx .body p{color:rgba(255,255,255,.66);font-size:.93rem;line-height:1.7;font-weight:300;margin:0 0 .85rem;max-width:660px}
  .wsx .body p:last-child{margin-bottom:0}
  .wsx .body a{color:var(--teal)}
  .wsx .shot{margin:1.15rem 0 0;max-width:660px}
  .wsx .shot img{width:100%;display:block;height:auto;border-radius:9px;border:1px solid rgba(255,255,255,.1);background:#0a1620}
  .wsx .shot figcaption{color:rgba(255,255,255,.38);font-size:.78rem;font-weight:300;margin-top:.5rem}

  .ws-more{max-width:1040px;margin:2.8rem auto 0;padding:0 6%}
  .ws-more h3{font-family:'DM Serif Display',serif;color:#fff;font-size:1.15rem;font-weight:400;margin:0 0 .35rem}
  .ws-more p{color:rgba(255,255,255,.55);font-size:.9rem;font-weight:300;line-height:1.65;margin:0 0 1rem;max-width:660px}
  .ws-more .tags{display:flex;flex-wrap:wrap;gap:.45rem}
  .ws-more .tags span{font-size:.79rem;color:rgba(255,255,255,.55);border:1px solid rgba(255,255,255,.13);border-radius:999px;padding:5px 11px}

  /* the receipts band. this is the part that separates him from a deck */
  .ws-proof{background:#0c1620;border-top:1px solid rgba(255,255,255,.08);
    border-bottom:1px solid rgba(255,255,255,.08);margin-top:3.4rem}
  .ws-proof-in{max-width:1040px;margin:0 auto;padding:3.6rem 6%}
  .ws-proof .eyebrow{color:var(--teal);font-size:.72rem;font-weight:700;letter-spacing:.15em;text-transform:uppercase}
  .ws-proof h2{font-family:'DM Serif Display',serif;font-size:clamp(1.7rem,3vw,2.3rem);color:#fff;font-weight:400;margin:.5rem 0 1.9rem}
  .ws-cases{display:grid;grid-template-columns:1fr 1fr;gap:2rem}
  .ws-case{border-top:2px solid var(--teal);padding-top:1.05rem}
  .ws-case .when{font-size:.7rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--teal);margin-bottom:.4rem}
  .ws-case h3{font-family:'DM Serif Display',serif;color:#fff;font-size:1.16rem;font-weight:400;margin:0 0 .55rem;line-height:1.25}
  .ws-case p{color:rgba(255,255,255,.66);font-size:.92rem;line-height:1.62;font-weight:300;margin:0 0 .7rem}
  .ws-case p:last-child{margin-bottom:0}
  .ws-case .limit{color:rgba(255,255,255,.44);font-size:.84rem;font-style:italic}
  .ws-case img{width:100%;display:block;height:auto;border-radius:9px;border:1px solid rgba(255,255,255,.1);margin:0 0 .95rem;background:#0a1620}

  .ws-how{max-width:1040px;margin:0 auto;padding:3.6rem 6% 0}
  .ws-how h2{font-family:'DM Serif Display',serif;font-size:clamp(1.7rem,3vw,2.3rem);color:#fff;font-weight:400;margin:0 0 1.6rem}
  .ws-how ol{margin:0;padding:0;list-style:none;display:grid;gap:1.15rem;counter-reset:s}
  .ws-how li{counter-increment:s;display:grid;grid-template-columns:auto minmax(0,1fr);gap:.25rem 1.1rem;align-items:baseline}
  .ws-how li::before{content:counter(s,decimal-leading-zero);font-family:'DM Serif Display',serif;
    color:var(--teal);font-size:1.3rem;line-height:1;grid-column:1;grid-row:1 / span 2}
  .ws-how li b{color:#fff;font-weight:600;font-size:.98rem;grid-column:2;grid-row:1}
  .ws-how li span{color:rgba(255,255,255,.66);font-size:.94rem;line-height:1.6;font-weight:300;display:block;grid-column:2;grid-row:2;max-width:640px}

  .ws-close{margin:3.6rem 0 0}
  .ws-close img{width:100%;display:block;aspect-ratio:1200/800;height:auto;max-height:52vh;object-fit:cover;object-position:center 42%;
    border-top:1px solid rgba(0,188,212,.18);border-bottom:1px solid rgba(0,188,212,.18);background:#0a1620}
  .ws-close p{max-width:1040px;margin:1.3rem auto 0;padding:0 6%;color:rgba(255,255,255,.7);
    font-family:'DM Serif Display',serif;font-size:clamp(1.05rem,2vw,1.3rem);font-weight:400;line-height:1.5}
  @media(max-width:820px){.ws-cases{grid-template-columns:1fr}.wm-tablist{gap:1.4rem}.wsx>summary{padding:1.15rem 1.2rem}.wsx .body{padding:0 1.2rem 1.3rem}}
</style>
