<script>(function(){var h=document.querySelector(".nav-hamburger"),n=document.getElementById("nav");if(h&&n)h.addEventListener("click",function(){n.classList.toggle("open");});})();</script>

<script>
(function(){
  var tabs=[].slice.call(document.querySelectorAll('.wm-tab'));
  if(!tabs.length) return;
  function show(id){
    tabs.forEach(function(t){
      var on = t.id===id;
      t.setAttribute('aria-selected', on?'true':'false');
      t.tabIndex = on?0:-1;
      var panel=document.getElementById(t.getAttribute('aria-controls'));
      if(panel) panel.hidden = !on;
    });
    var note=document.getElementById('tabnote');
    if(note) note.textContent = id==='tab-workshop'
      ? 'Nine sessions, plus an honest conversation about which one you actually need.'
      : 'An engagement is a season. A workshop is a day. Most people start with the second one.';
  }
  tabs.forEach(function(t,i){
    t.addEventListener('click', function(){
      show(t.id);
      if(history.replaceState) history.replaceState(null,'', t.id==='tab-workshop'?'#workshop':'#work');
    });
    t.addEventListener('keydown', function(e){
      var d = e.key==='ArrowRight'?1 : e.key==='ArrowLeft'?-1 : 0;
      if(!d) return;
      e.preventDefault();
      var n=tabs[(i+d+tabs.length)%tabs.length];
      n.focus(); n.click();
    });
  });
  if(location.hash==='#workshop') show('tab-workshop');
})();
</script>
</body>
