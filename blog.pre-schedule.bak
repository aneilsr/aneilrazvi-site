<link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="site.css">
<style>
  .bl-hero{max-width:1140px;margin:0 auto;padding:9rem 6% 1.5rem}
  .bl-hero .eyebrow{color:var(--teal);font-size:.78rem;font-weight:700;letter-spacing:.15em;text-transform:uppercase}
  .bl-hero h1{font-family:'DM Serif Display',serif;font-size:clamp(2.6rem,6vw,4.2rem);color:#fff;font-weight:400;margin:.4rem 0 1.1rem;line-height:1.08}
  .bl-hero h1 em{font-style:italic;color:var(--teal)}
  .bl-hero p{max-width:720px;color:rgba(255,255,255,.72);font-size:1.14rem;line-height:1.75;font-weight:300}
  .bl-sec{max-width:1140px;margin:0 auto;padding:2.5rem 6%}
  .bl-eyebrow{color:var(--teal);font-size:.72rem;font-weight:700;letter-spacing:.15em;text-transform:uppercase;display:block;margin-bottom:.7rem}
  .bl-h2{font-family:'DM Serif Display',serif;font-size:clamp(1.7rem,3vw,2.3rem);color:#fff;font-weight:400;margin:0 0 1.4rem}
  /* featured newsletter */
  .bl-feature{background:linear-gradient(135deg,rgba(0,188,212,.12),rgba(0,188,212,.03));border:1px solid rgba(0,188,212,.35);border-radius:18px;padding:2.4rem 2.6rem;display:flex;gap:2rem;align-items:center;flex-wrap:wrap}
  .bl-feature .txt{flex:1;min-width:280px}
  .bl-feature .tag{display:inline-block;font-size:.7rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--teal);background:rgba(0,188,212,.12);border:1px solid rgba(0,188,212,.3);padding:4px 12px;border-radius:100px;margin-bottom:1rem}
  .bl-feature h3{font-family:'DM Serif Display',serif;color:#fff;font-size:1.9rem;font-weight:400;margin:0 0 .7rem}
  .bl-feature p{color:rgba(255,255,255,.78);font-size:1.02rem;line-height:1.65;font-weight:300;margin:0 0 1.3rem;max-width:620px}
  .bl-feature a.sub{display:inline-block;background:var(--teal);color:#062028;padding:12px 26px;border-radius:8px;font-weight:700;text-decoration:none;font-size:.92rem}
  /* article grid */
  .bl-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1.6rem}
  .art{background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.09);border-radius:14px;overflow:hidden;display:flex;flex-direction:column;text-decoration:none;color:inherit;transition:transform .18s,border-color .18s}
  .art:hover{transform:translateY(-4px);border-color:rgba(0,188,212,.45)}
  .art .thumb{aspect-ratio:16/9;width:100%;object-fit:cover;display:block;background:#0a1620}
  .art .rd{color:var(--teal);font-weight:600;font-size:.86rem;margin-top:auto}
  .art .body{padding:1.3rem 1.4rem 1.5rem;flex:1;display:flex;flex-direction:column}
  .art .cat{font-size:.68rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--teal);margin-bottom:.5rem}
  .art h4{font-family:'DM Serif Display',serif;color:#fff;font-size:1.18rem;font-weight:400;margin:0 0 .5rem;line-height:1.25}
  .art p{color:rgba(255,255,255,.62);font-size:.9rem;line-height:1.55;font-weight:300;margin:0 0 1rem;flex:1}
  .art a{color:var(--teal);font-weight:600;font-size:.86rem;text-decoration:none}
  .bl-note{color:rgba(255,255,255,.5);font-size:.9rem;margin-top:1.4rem;font-style:italic}

  /* Covers are the real LinkedIn artwork. Issues run dark, Sidenotes run light,
     which is the convention already set on the covers themselves. */
  .art .cover{aspect-ratio:16/9;width:100%;height:auto;object-fit:cover;display:block;background:#0a1620;
    border-bottom:1px solid rgba(255,255,255,.08)}
  .art.side .cover{border-bottom-color:rgba(255,255,255,.22)}
  .art .cat{font-size:.68rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;
    color:var(--teal);margin-bottom:.5rem}
  .art.side{background:rgba(255,255,255,.075);border-color:rgba(255,255,255,.16)}
  .art.side:hover{border-color:rgba(255,255,255,.34)}
  .art.side .cat,.art.side .rd{color:rgba(255,255,255,.78)}
  .bl-sub{color:rgba(255,255,255,.6);font-size:1rem;line-height:1.7;font-weight:300;
    max-width:640px;margin:-.7rem 0 1.6rem}

  /* Each cover carries its own dark ground. The card picks it up so the grid
     reads like the covers rather than like a list of links. */
  .art[data-hue="foundation"]{background:#0d1523;border-color:#1b2740}
  .art[data-hue="foundation"]:hover{border-color:#33507e}
  .art[data-hue="wall"]{background:#181327;border-color:#271f3e}
  .art[data-hue="wall"]:hover{border-color:#483a6e}
  .art[data-hue="solo"]{background:#0c1a16;border-color:#172c25}
  .art[data-hue="solo"]:hover{border-color:#2c5546}
  .art[data-hue="gate"]{background:#1a1510;border-color:#2b231a}
  .art[data-hue="gate"]:hover{border-color:#4d3f2d}
  .art[data-hue="build"]{background:#1c1526;border-color:#2d2340}
  .art[data-hue="build"]:hover{border-color:#503d6f}
  .art.side[data-hue="sidenote"]{background:#eef1f5;border-color:#d7dde6}
  .art.side[data-hue="sidenote"]:hover{border-color:#9fb0c4}
  .art.side[data-hue="sidenote"] h4{color:#151c25}
  .art.side[data-hue="sidenote"] p{color:#4a5763}
  .art.side[data-hue="sidenote"] .cat{color:#0f6b7a}
  .art.side[data-hue="sidenote"] .rd{color:#0f6b7a}
  .art.side .cover{border-bottom-color:#d7dde6}

  /* The covers are drawn on an 80px grid. The whole page carries the same grid at
     the same module, so every card reads as cut from one sheet and the gutters are
     the sheet showing through. Fixed attachment so it does not slide under scroll. */
  body{position:relative}
  body::before{content:"";position:fixed;inset:0;z-index:0;pointer-events:none;
    background-image:linear-gradient(to right,rgba(255,255,255,.045) 1px,transparent 1px),
                     linear-gradient(to bottom,rgba(255,255,255,.045) 1px,transparent 1px);
    background-size:80px 80px;background-position:center top}
  body > *{position:relative;z-index:1}
  .art{position:relative;z-index:1}
  @media(max-width:900px){.bl-grid{grid-template-columns:1fr}}

  /* Editions mirror the LinkedIn covers: numbered issues run dark, Sidenotes run light. */
  .art{position:relative}
  .art .cat{display:flex;align-items:center;gap:.55rem}
  .art .num{font-family:'DM Serif Display',serif;font-size:1.5rem;line-height:1;color:var(--teal);
    letter-spacing:0;text-transform:none;font-weight:400;margin-right:.15rem}
  .art.side{background:rgba(255,255,255,.075);border-color:rgba(255,255,255,.16)}
  .art.side:hover{border-color:rgba(255,255,255,.34)}
  .art.side .cat,.art.side .num{color:rgba(255,255,255,.72)}
  .art.side a{color:rgba(255,255,255,.82)}
  .art .thumb-ph{aspect-ratio:16/9;width:100%;display:flex;align-items:flex-end;padding:1.1rem 1.3rem;
    background:linear-gradient(160deg,#0c1620,#0F1923 60%,#10202b);
    border-bottom:1px solid rgba(0,188,212,.16)}
  .art.side .thumb-ph{background:linear-gradient(160deg,#eef1f5,#F4F6F8 60%,#e8edf3);
    border-bottom:1px solid rgba(255,255,255,.2)}
  .art .thumb-ph span{font-family:'DM Serif Display',serif;font-size:1.25rem;line-height:1.15;color:#fff}
  .art.side .thumb-ph span{color:#151C25}
</style>
<script defer src="assets/analytics.js"></script>
</head>
