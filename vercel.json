{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/workshop",
      "destination": "/api/go?s=workshop"
    },
    {
      "source": "/panel",
      "destination": "/api/go?s=panel"
    },
    {
      "source": "/podcast",
      "destination": "/api/go?s=podcast"
    },
    {
      "source": "/check",
      "destination": "/api/go?s=check"
    },
    {
      "source": "/map",
      "destination": "/api/go?s=map"
    },
    {
      "source": "/job",
      "destination": "/api/go?s=job"
    },
    {
      "source": "/build",
      "destination": "/api/go?s=build"
    },
    {
      "source": "/squares",
      "destination": "/api/go?s=squares"
    },
    {
      "source": "/paper-to-ai",
      "destination": "/api/go?s=paper-to-ai"
    },
    {
      "source": "/seat",
      "destination": "/api/go?s=seat"
    },
    {
      "source": "/kit",
      "destination": "/api/go?s=kit"
    },
    {
      "source": "/build/how-it-works",
      "destination": "/build/how-it-works.html"
    },
    {
      "source": "/build/faq",
      "destination": "/build/faq.html"
    },
    {
      "source": "/build/teams",
      "destination": "/build/teams.html"
    },
    {
      "source": "/build/portfolio",
      "destination": "/build/portfolio.html"
    },
    {
      "source": "/build/paper-to-ai",
      "destination": "/build/paper-to-ai.html"
    },
    {
      "source": "/build/path",
      "destination": "/build/path.html"
    },
    {
      "source": "/build/one-source-of-truth",
      "destination": "/build/one-source-of-truth.html"
    },
    {
      "source": "/build/cubby",
      "destination": "/build/cubby.html"
    },
    {
      "source": "/build/smooshdoku",
      "destination": "/build/smooshdoku.html"
    },
    {
      "source": "/build/summit-vip",
      "destination": "/build/summit-vip.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self'; base-uri 'self'; object-src 'none'"
        }
      ]
    }
  ]
}
